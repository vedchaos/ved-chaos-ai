# ==============================================================================
# VED CHAOS AI - ENVIRONMENT CONFIGURATION
# Copy this file to .env: cp .env.example .env
# Never commit a real .env file with production credentials to version control.
# ==============================================================================

# 1. Cloud PostgreSQL (Optional - for long-term pgvector and FTS memory)
# Leave empty if running purely local with SQLite state persistence.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
VED_USER_ID=ved-local

# 2. Bi-Factor Persona Gate Credentials (Optional - unlocks custom developer persona & memory)
# Note: 5 consecutive failed attempts trigger an automatic 300-second lockout.
VED_SECURITY_PIN=your_custom_pin_here
VED_ACTIVATION_PHRASE=your_secret_phrase_here

# 3. Memory & Search Limits
MAX_SEARCH_RESULTS=10
MAX_TEXT_CHARS=12000

# 4. FastMCP Transport Settings
# Transport options: stdio (default for IDEs), sse, or streamable-http
MCP_TRANSPORT=stdio
PORT=8000
