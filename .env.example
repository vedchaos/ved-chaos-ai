# Use the direct PostgreSQL connection string from your cloud provider.
# Keep this secret. Never commit a real .env file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
VED_USER_ID=ved-local
VED_SECURITY_PIN=your_private_pin_here
VED_ACTIVATION_PHRASE=your_secret_phrase_here
MAX_SEARCH_RESULTS=10
MAX_TEXT_CHARS=12000
